# ==============================================================================
# AgriMarket — Unified Centralized Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your local secrets.

# ------------------------------------------------------------------------------
# 1. Database & Core Server (Backend)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/final_project?schema=public"
PORT=5000
NODE_ENV=development

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 2. Application URLs & Cross-Origin Links (Configure with hosted domains in production)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 3. Brevo (Sendinblue) Transactional Email Service
# ------------------------------------------------------------------------------
# Used for OTP verification and Welcome notifications when user provides an email.
BREVO_API_KEY=your_brevo_api_key_v3
BREVO_SENDER_EMAIL=notifications@agrimarket.et
BREVO_SENDER_NAME="AgriMarket Ethiopia"

# ------------------------------------------------------------------------------
# 4. Ethio Telecom / Geez SMS Gateway
# ------------------------------------------------------------------------------
# Used for OTP verification (when email is omitted) and Draft Resumption SMS.
GEEZ_SMS_TOKEN=your_geez_sms_token
GEEZ_SMS_SENDER_ID=AgriMarket
ETHIO_TELECOM_SMS_API_KEY=your_ethio_telecom_token

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6.Google Cloudinary
# ------------------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 7. Location & Proximity Dispatch
# ------------------------------------------------------------------------------
LOCATION_FEATURE_ENABLED=true
DEFAULT_COUNTRY_CODE=ET
LOCATION_SRID=4326
LOCATION_MAX_ACCURACY_METERS=100
FARMER_SEARCH_RADIUS_KM=20
WORKER_LOCATION_MAX_AGE_SECONDS=300

# ------------------------------------------------------------------------------
# 8. Chapa Payment Gateway
# ------------------------------------------------------------------------------
CHAPA_MODE=test
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# In production on Render: https://agricultural-marketplace-hthx.onrender.com/api/payment/chapa/webhook
CHAPA_WEBHOOK_URL=http://localhost:5000/api/payment/chapa/webhook

# ------------------------------------------------------------------------------
# 7. Location & Proximity Dispatch
# ------------------------------------------------------------------------------
LOCATION_FEATURE_ENABLED=true
DEFAULT_COUNTRY_CODE=ET
LOCATION_SRID=4326
LOCATION_MAX_ACCURACY_METERS=100
FARMER_SEARCH_RADIUS_KM=20
WORKER_LOCATION_MAX_AGE_SECONDS=300

# ------------------------------------------------------------------------------
# 8. Chapa Payment Gateway
# ------------------------------------------------------------------------------
CHAPA_MODE=test
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# In production on Render: https://agricultural-marketplace-hthx.onrender.com/api/payment/chapa/webhook
CHAPA_WEBHOOK_URL=http://localhost:5000/api/payment/chapa/webhook
