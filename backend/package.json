    "start": "node dist/index.js",
    "test": "node --loader ts-node/esm src/tests/boundary.test.ts && node --loader ts-node/esm src/tests/auth.test.ts && node --loader ts-node/esm src/tests/location.test.ts && node --loader ts-node/esm src/tests/delivery.test.ts && node --loader ts-node/esm src/tests/onboarding.test.ts && node --loader ts-node/esm src/tests/superadmin.test.ts && node --loader ts-node/esm src/tests/routes-auth.test.ts",
    "test:boundary": "node --loader ts-node/esm src/tests/boundary.test.ts",
    "test:auth": "node --loader ts-node/esm src/tests/auth.test.ts",
    "test:google": "node --loader ts-node/esm src/tests/google-auth.test.ts",
    "test:location": "node --loader ts-node/esm src/tests/location.test.ts",
    "test:delivery": "node --loader ts-node/esm src/tests/delivery.test.ts",
    "test:onboarding": "node --loader ts-node/esm src/tests/onboarding.test.ts",
    "test:admin": "node --loader ts-node/esm src/tests/admin.test.ts",
    "test:superadmin": "node --loader ts-node/esm src/tests/superadmin.test.ts",
    "test:routes": "node --loader ts-node/esm src/tests/routes-auth.test.ts",
    "test:guest": "node --loader ts-node/esm src/tests/guest-browsing.test.ts",
    "seed": "node --loader ts-node/esm src/scripts/seed.ts"
  },
  "keywords": [],
  "author": "",
