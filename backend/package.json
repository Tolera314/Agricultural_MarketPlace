    "multer": "^2.5.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
